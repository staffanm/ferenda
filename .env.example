# Compose reads this file as `.env` beside docker-compose.prod.yml. Copy it,
# fill in real values, and keep the copy untracked (`/.env` is in .gitignore).
# Nothing here may ever be committed: a password in the repo is a password
# every reader of the repo has, and removing it later does not un-share it.

# Which profile `docker compose up -d` starts without --profile.
COMPOSE_PROFILES=prod

# MariaDB's root account. Only reachable over the container's unix socket
# (`docker exec ferenda_db_1 mariadb -uroot -p`) -- the `root`@`%` grant that
# let any peer on the compose network log in as root is dropped.
#
# The entrypoint reads this ONLY when the `db` volume is first created. On an
# existing volume it is inert: rotate with `ALTER USER` against the running
# server, then update this file to match, or the two drift apart silently.
MARIADB_ROOT_PASSWORD=

# The least-privilege account Matomo connects with: rights on `matomo`.* only,
# and nothing at all on any other database. Changing it takes two writes --
# `ALTER USER` in MariaDB and the `[database]` block of Matomo's own
# config/config.ini.php, which is authoritative once it exists and ignores the
# MATOMO_DATABASE_* environment.
MATOMO_DB_PASSWORD=

# Generate either with:
#   openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 28
