# Individual credentials for the read-only rsync daemon (`rsync` service in
# docker-compose.yml, TCP port 873). Copy to `rsyncd.secrets` on the prod host
# (`~/wds/ferenda/rsyncd.secrets`, untracked -- `/rsyncd.secrets` is in
# .gitignore) before starting the service:
#
#   cp rsyncd.secrets.example rsyncd.secrets
#   chmod 600 rsyncd.secrets
#
# Format: one `username:password` per line (plain text; rsyncd uses it for its
# challenge-response handshake over port 873, so it cannot be pre-hashed).
# Generate a password with:
#
#   openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 28
#
# After adding or removing a line, reload the daemon:
#
#   docker compose --profile prod restart rsync
#
# Reusers connect with:
#
#   rsync -av --password-file=~/.lagen-rsync-pass rsync://<username>@lagen.nu/artifact/sfs/ ./sfs-artifact/
#   rsync -av --password-file=~/.lagen-rsync-pass rsync://<username>@lagen.nu/downloaded/sfs/ ./sfs-downloaded/
#
# Example:
# jurisfons:REPLACE_WITH_GENERATED_SECRET
